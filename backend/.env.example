AI_ASSISTANT_APP_NAME=Local AI Assistant
AI_ASSISTANT_API_PREFIX=/api
AI_ASSISTANT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

AI_ASSISTANT_DATABASE_URL=postgresql+psycopg://ai_assistant:ai_assistant@localhost:56000/ai_assistant

AI_ASSISTANT_LLM_PROVIDER=lm_studio_responses

AI_ASSISTANT_LM_STUDIO_BASE_URL=http://127.0.0.1:1234
# Chatmodell-profilok: egyszerre pontosan egy blokk négy beállítása legyen aktív.
# Profilváltás: az aktuális blokk négy sorát kommenteld ki (#), a másikét pedig
# engedélyezd; utána indítsd újra a backendet. A kontextusablakot továbbra is
# az LM Studio modellbetöltési beállításában kell megadni, nem itt.
#
# Aktív profil — qwen/qwen3.5-9b
AI_ASSISTANT_LM_STUDIO_CHAT_MODEL=qwen/qwen3.5-9b
AI_ASSISTANT_LM_STUDIO_DEFAULT_TEMPERATURE=0.1
AI_ASSISTANT_LM_STUDIO_DEFAULT_MAX_OUTPUT_TOKENS=
AI_ASSISTANT_CONTEXT_CHAR_BUDGET=120000
#
# Alternatív profil — qwen/qwen3.6-35b-a3b (LM Studio context window: 15360)
# AI_ASSISTANT_LM_STUDIO_CHAT_MODEL=qwen/qwen3.6-35b-a3b
# AI_ASSISTANT_LM_STUDIO_DEFAULT_TEMPERATURE=0.1
# AI_ASSISTANT_LM_STUDIO_DEFAULT_MAX_OUTPUT_TOKENS=
# AI_ASSISTANT_CONTEXT_CHAR_BUDGET=30000
AI_ASSISTANT_LM_STUDIO_REQUEST_TIMEOUT_SECONDS=180
# MCP végrehajtási módok: egyszerre pontosan egy sor legyen aktív.
# Aktív: az LM Studio mcp.json-ban regisztrált pluginok használata.
AI_ASSISTANT_LM_STUDIO_MCP_EXECUTION_MODE=lmstudio_registered
# Korábbi, kérésenkénti Responses remote MCP mód egy mozdulatos visszakapcsolása:
# AI_ASSISTANT_LM_STUDIO_MCP_EXECUTION_MODE=responses_remote
# Optional: required when LM Studio API authentication is enabled.
AI_ASSISTANT_LM_STUDIO_API_TOKEN=
AI_ASSISTANT_LM_STUDIO_OBSIDIAN_INTEGRATION_ID=mcp/obsidian
AI_ASSISTANT_LM_STUDIO_EXCEL_INTEGRATION_ID=mcp/excel
# Used only when AI_ASSISTANT_LM_STUDIO_MCP_EXECUTION_MODE=responses_remote.
AI_ASSISTANT_LM_STUDIO_RESPONSES_EXCEL_MCP_URL=http://127.0.0.1:8017/mcp
AI_ASSISTANT_LM_STUDIO_RESPONSES_OBSIDIAN_MCP_URL=
AI_ASSISTANT_LM_STUDIO_RESPONSES_OBSIDIAN_MCP_TOKEN=
AI_ASSISTANT_SENSITIVE_REQUEST_GUARD_ENABLED=true
AI_ASSISTANT_SENSITIVE_OUTPUT_GUARD_ENABLED=true

# Optional standalone GraphRAG Knowledge Service integration.
# Required only when the explicit GraphRAG mode is used.
AI_ASSISTANT_GRAPHRAG_BASE_URL=http://127.0.0.1:8080
AI_ASSISTANT_GRAPHRAG_SERVICE_TOKEN=
AI_ASSISTANT_GRAPHRAG_REQUEST_TIMEOUT_SECONDS=30
AI_ASSISTANT_GRAPHRAG_RESULT_LIMIT=10
AI_ASSISTANT_GRAPHRAG_CONTEXT_CHAR_BUDGET=60000
AI_ASSISTANT_GRAPHRAG_MAX_RESPONSE_BYTES=2097152
AI_ASSISTANT_GRAPHRAG_VAULT_ID=
AI_ASSISTANT_SYSTEM_PROMPT=You are a helpful local AI assistant.
